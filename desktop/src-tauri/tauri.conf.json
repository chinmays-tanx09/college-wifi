{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "College WiFi",
  "version": "1.1.0",
  "identifier": "bot.paradox.wifi.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "College WiFi",
        "width": 900,
        "height": 620,
        "minWidth": 380,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "publisher": "Paradox",
    "copyright": "\u00a9 2026 Paradox \u00b7 MIT",
    "category": "Utility",
    "shortDescription": "Auto sign-in for the college Wi-Fi portal",
    "longDescription": "College WiFi signs you in to the campus captive portal (IIIT Dharwad, Sophos) automatically, shows today's data left, and lives in your tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}